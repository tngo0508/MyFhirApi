{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Fhir": "Server=(localdb)\\MSSQLLocalDB;Database=MyFhirApi;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Smart": {
    "Enabled": true,
    "AuthorizeEndpoint": "https://example.org/oauth2/authorize",
    "TokenEndpoint": "https://example.org/oauth2/token"
  },
  "SampleData": {
    "LoadOnStartup": false
  }
}
